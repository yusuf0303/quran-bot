import random
from apscheduler.schedulers.background import BackgroundScheduler
from telegram import Bot
import pytz
import logging
from SchedulerAyah.send_daily_ayah import send_daily_random_ayah_to_all_users


def start_daily_ayah_scheduler(bot_token):
    bot = Bot(token=bot_token)
    scheduler = BackgroundScheduler(timezone=pytz.timezone("Asia/Tashkent"))

    # Random soat va daqiqa tanlash: 06:00–20:00 oralig‘ida
    random_hour = random.randint(6, 20)
    random_minute = random.randint(0, 59)

    # Logging sozlamalari
    logging.basicConfig(level=logging.INFO)
    logging.info(f"📅 Daily ayah job soat {random_hour:02d}:{random_minute:02d} da rejalashtirildi.")

    # Jobni qo‘shish
    scheduler.add_job(
        send_daily_random_ayah_to_all_users,
        trigger='cron',
        hour=random_hour,
        minute=random_minute,
        args=[bot],
        id="daily_ayah_job",
        replace_existing=True
    )

    scheduler.start()

    # Hozirgi rejalashtirilgan ishlarni ko‘rsatish
    for job in scheduler.get_jobs():
        logging.info(f"🕓 Job '{job.id}' — keyingi ish vaqti: {job.next_run_time}")

    return scheduler

